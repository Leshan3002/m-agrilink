<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="National Market Corridor Analyzer"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_terracotta"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- County Selector Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select County Hub"
                app:boxStrokeColor="@color/accent_gold"
                app:hintTextColor="@color/primary_terracotta"
                android:layout_marginBottom="16dp">

                <AutoCompleteTextView
                    android:id="@+id/selectCountyHub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Regional Crops ListView -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Crop for Analysis"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/label_charcoal"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/cropYieldListView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:layout_marginBottom="16dp"
                android:background="#1A1A1A"/>

            <!-- Arbitrage & Advisory Output Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/arbitrageOutputCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/accent_gold"
                app:strokeWidth="1dp"
                android:backgroundTint="@color/card_surface_white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtArbitrageHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Market Intelligence Matrix"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_terracotta"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/txtMarketAnalyticsOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select a regional crop from the frame above to compile pricing models and agronomic training modules."
                        android:textSize="14sp"
                        android:textColor="@color/label_charcoal"
                        android:lineSpacingMultiplier="1.2"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Launch Regional Analyzer Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunchRegionalAnalyzer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch Meteorological Hub"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary_terracotta"
                app:cornerRadius="8dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:itemIconTint="@color/primary_terracotta"
        app:itemTextColor="@color/label_charcoal"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>