<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/accent_gold"
    android:backgroundTint="@color/card_surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtDestinationHubName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Destination Hub"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_terracotta"/>

            <TextView
                android:id="@+id/txtViabilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/label_charcoal"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="8dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <TextView
                android:id="@+id/txtTargetPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Ceiling Price: KES 0.00"
                android:textSize="13sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/txtTransitCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Transit Overhead: KES 0.00"
                android:textSize="13sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/txtGrossProfit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="Gross Margin: KES 0.00"
                android:textSize="13sp"
                android:textColor="#555555"/>

            <TextView
                android:id="@+id/txtNetProfit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginTop="4dp"
                android:text="Net Profit: KES 0.00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"/>
        </GridLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
