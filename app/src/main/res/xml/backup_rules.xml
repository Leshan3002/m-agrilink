<?xml version="1.0" encoding="utf-8"?>
<!-- Farm data stays on the phone: encrypted DB + keystore prefs are excluded. -->
<full-backup-content>
    <exclude domain="database" path="magrilink_database"/>
    <exclude domain="database" path="magrilink_database-wal"/>
    <exclude domain="database" path="magrilink_database-shm"/>
    <exclude domain="database" path="magrilink_database-journal"/>
    <exclude domain="sharedpref" path="magrilink_keystore_prefs.xml"/>
    <exclude domain="sharedpref" path="magrilink_keystore_prefs_fallback.xml"/>
</full-backup-content>
